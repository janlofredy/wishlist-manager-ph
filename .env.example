# Port to bind
PORT=3000

# Persistent data directory
DATA_DIR=/app/data

# Database connection string (SQLite by default)
DATABASE_URL=sqlite:/app/data/wishlist.db?mode=rwc

# Secret key for signing JWT tokens (generate a random 32+ character string)
JWT_SECRET=ph-wishlist-manager-super-secret-key-replace-me

# Optional: Telegram Bot integration for price drops and sale reminders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Discord Webhook integration
DISCORD_WEBHOOK_URL=

# Location of built frontend static assets (default for production container: /app/frontend_build)
FRONTEND_DIR=frontend/build
